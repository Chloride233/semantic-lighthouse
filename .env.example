# App
APP_ENV=development
DATABASE_URL=postgresql+psycopg://semantic_lighthouse:semantic_lighthouse@localhost:5432/semantic_lighthouse
JWT_SECRET_KEY=change-me-in-dev-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=semantic_lighthouse_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Storage
KNOWLEDGE_BASE_PATH=./knowledge-graph
MAX_MARKDOWN_UPLOAD_BYTES=1048576
DOCUMENT_STORAGE_PATH=./document-storage
UPLOAD_TMP_PATH=./upload-tmp
DATASET_STORAGE_PATH=./dataset-storage
MAX_DOCUMENT_UPLOAD_BYTES=52428800
UPLOAD_SESSION_EXPIRE_HOURS=24
UPLOAD_CHUNK_BYTES=2097152

# Embedding
# For deployment smoke without real API keys, set EMBEDDING_PROVIDER=fake
EMBEDDING_PROVIDER=aliyun
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=30

# Chat / RAG
# For deployment smoke without real API keys, set CHAT_PROVIDER=fake
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_TIMEOUT_SECONDS=60
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.1
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_CONCURRENCY=20
RAG_MAX_QUEUE=40
RAG_QUEUE_TIMEOUT_SECONDS=2
RAG_RATE_LIMIT_REQUESTS=120
RAG_RATE_LIMIT_WINDOW_SECONDS=60

# Agent
AGENT_MAX_STEPS=5
