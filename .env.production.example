POSTGRES_DB=semantic_lighthouse
POSTGRES_USER=semantic_lighthouse
POSTGRES_PASSWORD=replace-with-a-strong-database-password

API_PORT=8000
API_WORKERS=1

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=semantic_lighthouse_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

KNOWLEDGE_BASE_PATH=/app/knowledge-graph
MAX_MARKDOWN_UPLOAD_BYTES=1048576
DOCUMENT_STORAGE_PATH=/app/document-storage
UPLOAD_TMP_PATH=/app/upload-tmp
MAX_DOCUMENT_UPLOAD_BYTES=52428800
UPLOAD_SESSION_EXPIRE_HOURS=24
UPLOAD_CHUNK_BYTES=2097152

EMBEDDING_PROVIDER=aliyun
DASHSCOPE_API_KEY=replace-manually-on-server
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=30

CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-manually-on-server
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_TIMEOUT_SECONDS=60
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000
